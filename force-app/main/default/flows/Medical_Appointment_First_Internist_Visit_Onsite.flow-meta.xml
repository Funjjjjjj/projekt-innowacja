<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <decisions>
        <name>Decision_Is_Online_Internist</name>
        <label>Is it online and with internist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_Yes_Check_History</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Online</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Doctor__r.Specialization__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Internist</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Visits</targetReference>
            </connector>
            <label>Yes check history</label>
        </rules>
    </decisions>
    <decisions>
        <name>Were_visits_found</name>
        <label>Were any other visits found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_other_visits</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Visits</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>First_vistit_error</targetReference>
            </connector>
            <label>No other visits</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Medical Appointment: First Internist Visit Onsite {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Medical Appointment: First Internist Visit Onsite</label>
    <processMetadataValues>
