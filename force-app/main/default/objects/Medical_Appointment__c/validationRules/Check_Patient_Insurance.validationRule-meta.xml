<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Patient_Insurance</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
Medical_Facility__r.Insurance_Required__c = True,
ISBLANK(Patient__r.Medical_Insurence__c),
Patient__r.RecordType.DeveloperName = &quot;Patient&quot;
)</errorConditionFormula>
    <errorMessage>This medical facility require insurance. Patient doesn&apos;t have insurance number on profile.</errorMessage>
</ValidationRule>
